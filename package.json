{
  "name": "@cypherusuh/song-request",
  "version": "0.1.0",
  "description": "Reusable Twitch song-request bot and playback engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "streamops-twitch-connector": "^0.1.4"
  }
}
